-- TOKENS REVOCADOS (HU10: cerrar sesión)
-- Un JWT no se puede "borrar": sigue siendo válido hasta que expira. Al cerrar sesión se guarda
-- aquí su identificador (jti) y el sistema debe rechazar cualquier token que aparezca en esta tabla.
-- fecha_expiracion permite limpiar después las filas de tokens que ya caducaron por sí solos.
create table token_revocado (
    codigo_token      integer generated by default as identity primary key,
    jti               varchar(64) not null unique,   -- identificador único del token (claim "jti")
    fecha_expiracion  timestamp   not null           -- cuándo caduca el token (UTC)
);

create index idx_token_revocado_expiracion on token_revocado (fecha_expiracion);

-- Que la API pública de Supabase (anon/authenticated) no pueda leer ni escribir esta tabla.
-- El backend se conecta como dueño de la tabla, por eso no se ve afectado.
alter table token_revocado enable row level security;
