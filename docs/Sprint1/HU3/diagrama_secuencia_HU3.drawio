        <mxCell id="notas_t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;" value="Notas de implementación" vertex="1">
          <mxGeometry height="24" width="360" x="1700" y="70" as="geometry" />
        </mxCell>
        <mxCell id="nota_N1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N1&lt;/b&gt;&lt;br&gt;Endpoint: GET /api/metas?codigoUsuario=&lt;id&gt;. El código de usuario viaja por parámetro de forma temporal hasta que exista el login (JWT)." vertex="1">
          <mxGeometry height="80" width="360" x="1700" y="100" as="geometry" />
        </mxCell>
        <mxCell id="nota_N2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N2&lt;/b&gt;&lt;br&gt;Consulta con @Query: metas donde el usuario tiene participación ACEPTADA y la meta está ACTIVA, ordenadas por fechaCreacion descendente." vertex="1">
          <mxGeometry height="80" width="360" x="1700" y="196" as="geometry" />
        </mxCell>
        <mxCell id="nota_N3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N3&lt;/b&gt;&lt;br&gt;listarMetasActivas es @Transactional(readOnly = true). Cada Meta se convierte a MetaResponse (DTO): nunca se expone la entidad." vertex="1">
          <mxGeometry height="80" width="360" x="1700" y="292" as="geometry" />
        </mxCell>
        <mxCell id="nota_N4" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N4&lt;/b&gt;&lt;br&gt;Códigos HTTP: 200 lista de metas (puede ser vacía) · 404 usuario no existe · 500 error interno sin detalles." vertex="1">
          <mxGeometry height="62" width="360" x="1700" y="388" as="geometry" />
        </mxCell>
        <mxCell id="nota_N5" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N5&lt;/b&gt;&lt;br&gt;Si la lista llega vacía, la pantalla muestra el estado vacío; si trae metas, las muestra como tarjetas (estados D3/M5)." vertex="1">
