        <mxCell id="1x_JnLSAQ8EL8_6-nKH3-55" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;" value="Notas de implementación" vertex="1">
