        <mxCell id="1x_JnLSAQ8EL8_6-nKH3-56" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N1&lt;/b&gt;&lt;br&gt;Validación en el cliente: el formulario revisa campos vacíos antes de enviar (estados D2/M2). El servidor vuelve a validar siempre." vertex="1">
          <mxGeometry height="76" width="360" x="3282.2352941176473" y="536.1176470588236" as="geometry" />
        </mxCell>
        <mxCell id="1x_JnLSAQ8EL8_6-nKH3-57" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N2&lt;/b&gt;&lt;br&gt;Endpoint: POST /api/metas con cuerpo JSON {nombre, plazo, tipo}. codigoUsuario sale del token JWT (T8); mientras no exista el login se envía como parámetro." vertex="1">
          <mxGeometry height="76" width="360" x="3282.2352941176473" y="626.1176470588236" as="geometry" />
        </mxCell>
        <mxCell id="1x_JnLSAQ8EL8_6-nKH3-58" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N3&lt;/b&gt;&lt;br&gt;crearMeta es @Transactional: la meta, la participación y el registro se guardan juntos. Si algo falla: rollback y respuesta 500 (prueba PT-08)." vertex="1">
          <mxGeometry height="76" width="360" x="3282.2352941176473" y="716.1176470588236" as="geometry" />
        </mxCell>
        <mxCell id="1x_JnLSAQ8EL8_6-nKH3-59" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;N4&lt;/b&gt;&lt;br&gt;Al crear: estado = ACTIVA, oculta = false, fechaCreacion = hoy; participación del creador = ACEPTADA; primer registro con cumplimiento = false." vertex="1">
