generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Insignia {
  codigoInsignia    Int               @id @default(autoincrement())
  nombre            String            @db.VarChar
  descripcion       String
  icono             String            @db.VarChar
  plazoRequerido    plazo_enum
  tipoRequerido     tipo_meta_enum
  cantidadRequerida Int
  UsuarioInsignia   UsuarioInsignia[]
}

model ItemPersonalizacion {
  codigoItem  Int            @id @default(autoincrement())
  nombre      String         @db.VarChar
  tipo        tipo_item_enum
  costoPuntos Int
  recurso     String         @db.VarChar
  Mascota     Mascota?
  UsuarioItem UsuarioItem[]
}

model Mascota {
  codigoItem          Int                 @id
  esPorDefecto        Boolean             @default(false)
  ItemPersonalizacion ItemPersonalizacion @relation(fields: [codigoItem], references: [codigoItem], onDelete: Cascade, onUpdate: NoAction)
  Usuario             Usuario[]
}

model Meta {
  codigoMeta    Int              @id @default(autoincrement())
  creadorId     Int
  nombre        String           @db.VarChar
  plazo         plazo_enum
  tipo          tipo_meta_enum
  estado        estado_meta_enum @default(ACTIVA)
  oculta        Boolean          @default(false)
  fechaCreacion DateTime         @default(now()) @db.Timestamp(6)
  Usuario       Usuario          @relation(fields: [creadorId], references: [codigoUsuario], onDelete: Cascade, onUpdate: NoAction)
  Participacion Participacion[]
  Registro      Registro[]
}

model Participacion {
  codigoUsuario    Int
  codigoMeta       Int
  estadoInvitacion estado_invitacion_enum @default(PENDIENTE)
  fechaCumplida    DateTime?              @db.Timestamp(6)
  Meta             Meta                   @relation(fields: [codigoMeta], references: [codigoMeta], onDelete: Cascade, onUpdate: NoAction)
  Usuario          Usuario                @relation(fields: [codigoUsuario], references: [codigoUsuario], onDelete: Cascade, onUpdate: NoAction)

  @@id([codigoUsuario, codigoMeta])
}

model Registro {
  codigoRegistro Int      @id @default(autoincrement())
  codigoUsuario  Int
  codigoMeta     Int
  fechaRegistro  DateTime @default(now()) @db.Timestamp(6)
  cumplimiento   Boolean
  Meta           Meta     @relation(fields: [codigoMeta], references: [codigoMeta], onDelete: Cascade, onUpdate: NoAction)
  Usuario        Usuario  @relation(fields: [codigoUsuario], references: [codigoUsuario], onDelete: Cascade, onUpdate: NoAction)
}

model Usuario {
  codigoUsuario   Int               @id @default(autoincrement())
  nombre          String            @db.VarChar
  apellido        String            @db.VarChar
  email           String            @unique @db.VarChar
  passwordHash    String            @db.VarChar
  fotoPerfil      String?           @db.VarChar
  perfilPrivado   Boolean           @default(false)
  puntos          Int               @default(0)
  fechaRegistro   DateTime          @default(now()) @db.Timestamp(6)
  mascotaActivaId Int?
  Meta            Meta[]
  Participacion   Participacion[]
  Registro        Registro[]
  Mascota         Mascota?          @relation(fields: [mascotaActivaId], references: [codigoItem], onUpdate: NoAction)
  UsuarioInsignia UsuarioInsignia[]
  UsuarioItem     UsuarioItem[]
}

model UsuarioInsignia {
  codigoUsuario  Int
  codigoInsignia Int
  fechaObtenida  DateTime @default(now()) @db.Timestamp(6)
  Insignia       Insignia @relation(fields: [codigoInsignia], references: [codigoInsignia], onDelete: Cascade, onUpdate: NoAction)
  Usuario        Usuario  @relation(fields: [codigoUsuario], references: [codigoUsuario], onDelete: Cascade, onUpdate: NoAction)

  @@id([codigoUsuario, codigoInsignia])
}

model UsuarioItem {
  codigoUsuario       Int
  codigoItem          Int
  fechaObtenido       DateTime            @default(now()) @db.Timestamp(6)
  equipado            Boolean             @default(false)
  ItemPersonalizacion ItemPersonalizacion @relation(fields: [codigoItem], references: [codigoItem], onDelete: Cascade, onUpdate: NoAction)
  Usuario             Usuario             @relation(fields: [codigoUsuario], references: [codigoUsuario], onDelete: Cascade, onUpdate: NoAction)

  @@id([codigoUsuario, codigoItem])
}

enum estado_invitacion_enum {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum estado_meta_enum {
  ACTIVA
  CUMPLIDA
}

enum plazo_enum {
  CORTO
  MEDIANO
  LARGO
}

enum tipo_item_enum {
  COLOR
  TEMA
  ELEMENTO_VISUAL
}

enum tipo_meta_enum {
  PERSONAL
  PROFESIONAL
  FINANCIERA
  SOCIAL_FAMILIAR
  SALUD_BIENESTAR
  ACADEMICA
  RECREATIVA_OCIO
  OTRO
}
